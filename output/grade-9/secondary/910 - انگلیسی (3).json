        },
        {
          "lesson_number": 3,
          "title": "سومین کتاب از مجموعه کتاب‌های آموزش زبان انگلیسی پا نام ۳ ۳۲۰۹۰۶۶۶ برای آموزش در پایُ نهم"
        },
        {
          "lesson_number": 4,
          "title": "تحصیلی تألیف گردید و هم اکنون پیش روی شماست."
        },
        {
          "lesson_number": 5,
          "title": "برای آشنایی بیشتر با ویژگی‌های کلی مجموعه و کتاب حاضر. ضمن دعوت از مخاطبان به مطالعه"
        },
        {
          "lesson_number": 6,
          "title": "مقدمة کتاب‌های پایةُ هفتم و هشتم. نکات ذیل نیز به عنوان ویژگی‌های خاص کتاب زبان انگلیسی بای نهم"
        },
        {
          "lesson_number": 7,
          "title": "معرفی می‌گردد:"
        },
        {
          "lesson_number": 8,
          "title": "تاب ۳ ۳۲۰۹۳۶۶۱ دارای ذش درس است که همانند کتاب‌های پایةٌ هفتم و هشتم. هر درس حول"
        },
        {
          "lesson_number": 9,
          "title": "مضمون (۱۱۱۶۱۰۶) و یک یا جند کنش ارتباطی (۳۱۶۱۱۰۳) سازمان بندی و تألیف شده است."
        },
        {
          "lesson_number": 10,
          "title": "در این کتاب مضامین درس‌ها به تدریج از حیطه شخصی خارج گردیده و با افزایش سطح زبانی دانش‌آموزان؛"
        },
        {
          "lesson_number": 11,
          "title": "موقعیت‌ها و بافت‌های اجتماعی و زبانی پیشرفته تری در هر درس ارائه گردیده است."
        },
        {
          "lesson_number": 12,
          "title": "در ادامه منطقی فرایند سواد آموزی که در کتاب ۱)۳۲۰۹۳۶۶ با سطح آموزش الفبا آغاز گردید"
        },
        {
